name: <%= projectName %>

services:
  system:
    hostname: dev
    build:
      dockerfile: Dockerfile
    command: sleep infinity
    environment:
      - NODE_ENV=development
    volumes:
      - ..:/workspace:cached
      - home:/home/dev
    networks:
      back-tier: {}
      front-tier: {}

