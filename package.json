{
  "name": "@sektek/generator-base",
  "version": "0.5.0",
  "description": "Base Yeoman generator for scaffolding new SEKTEK projects (editorconfig, gitconfig, readme, devcontainer, workspace)",
  "author": "Edward Kelly <eddie@sektek.net>",
  "repository": {
    "type": "git",
    "url": "git@github.com:sektek/generator-base.git"
  },
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generators/*": {
      "types": "./dist/generators/*/index.d.ts",
      "default": "./dist/generators/*/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "!**/*.spec.?(c|m)js"
  ],
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json && npm run copy:templates",
    "copy:templates": "tsx scripts/copy-templates.ts",
    "lint": "eslint . --cache",
    "release": "release-it --ci",
    "test": "mocha",
    "test:cover": "c8 npm run test"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@sektek/generator": "^0.1.1",
    "@sektek/utility-belt": "^0.3.5",
    "tslib": "^2.8.1",
    "yeoman-generator": "^8.2.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@sektek/eslint-plugin": "^3",
    "@sektek/generator-test": "^0.1.0",
    "@sektek/prettier-config": "^2",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^10.1.3",
    "chai": "^6.2.1",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.1",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "prettier": "^3",
    "release-it": "^19.2.4",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "6.0.3"
  }
}
